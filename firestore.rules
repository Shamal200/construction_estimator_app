
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberPath(businessId, userId) {
      return /databases/$(database)/documents/businesses/$(businessId)/members/$(userId);
    }

    function businessPath(businessId) {
      return /databases/$(database)/documents/businesses/$(businessId);
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function isActiveMember(businessId) {
      return signedIn()
        && exists(memberPath(businessId, request.auth.uid))
        && get(memberPath(businessId, request.auth.uid)).data.isActive == true;
    }

    function hasRole(businessId, roles) {
      return isActiveMember(businessId)
        && get(memberPath(businessId, request.auth.uid)).data.role in roles;
    }

    function canManageBusiness(businessId) {
      return hasRole(businessId, ['owner', 'admin']);
    }

    function validNewBusiness(businessId) {
      return request.resource.data.keys().hasAll([
          'id',
          'name',
          'address',
          'phone',
          'email',
          'website',
          'businessRegistrationNumber',
          'taxRegistrationNumber',
          'currency',
          'defaultTaxRate',
          'createdAt',
          'ownerId',
          'status'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'name',
          'address',
          'phone',
          'email',
          'website',
          'businessRegistrationNumber',
          'taxRegistrationNumber',
          'currency',
          'defaultTaxRate',
          'createdAt',
          'ownerId',
          'status'
        ])
        && request.resource.data.id == businessId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 150
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.website is string
        && request.resource.data.businessRegistrationNumber is string
        && request.resource.data.taxRegistrationNumber is string
        && request.resource.data.currency is string
        && request.resource.data.currency.matches('^[A-Z]{3}$')
        && request.resource.data.defaultTaxRate is number
        && request.resource.data.defaultTaxRate >= 0
        && request.resource.data.defaultTaxRate <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'active'
        && getAfter(memberPath(businessId, request.auth.uid)).data.role == 'owner'
        && getAfter(memberPath(businessId, request.auth.uid)).data.userId == request.auth.uid
        && getAfter(memberPath(businessId, request.auth.uid)).data.businessId == businessId
        && getAfter(memberPath(businessId, request.auth.uid)).data.isActive == true
        && getAfter(userPath(request.auth.uid)).data.activeBusinessId == businessId
        && businessId in getAfter(userPath(request.auth.uid)).data.businessIds;
    }

    function validOwnerMembershipCreate(businessId, userId) {
      return signedIn()
        && userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId',
          'businessId',
          'role',
          'joinedAt',
          'isActive',
          'invitationId'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.businessId == businessId
        && request.resource.data.role == 'owner'
        && request.resource.data.isActive == true
        && request.resource.data.invitationId == null
        && request.resource.data.joinedAt == request.time
        && getAfter(businessPath(businessId)).data.ownerId == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.activeBusinessId == businessId
        && businessId in getAfter(userPath(request.auth.uid)).data.businessIds;
    }

    function validBusinessProfileUpdate(userId) {
      let oldIds = resource.data.businessIds;
      let newIds = request.resource.data.businessIds;
      let newBusinessId = request.resource.data.activeBusinessId;

      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['businessIds', 'activeBusinessId'])
        && newIds is list
        && newIds.size() == oldIds.size() + 1
        && newIds.hasAll(oldIds)
        && newBusinessId is string
        && newBusinessId in newIds
        && getAfter(businessPath(newBusinessId)).data.ownerId == userId
        && getAfter(memberPath(newBusinessId, userId)).data.role == 'owner'
        && getAfter(memberPath(newBusinessId, userId)).data.isActive == true
        && getAfter(memberPath(newBusinessId, userId)).data.businessId == newBusinessId;
    }

    function validProfile(userId) {
      return request.resource.data.keys().hasAll([
          'uid',
          'fullName',
          'email',
          'createdAt',
          'activeBusinessId',
          'businessIds',
          'subscriptionPlan',
          'subscriptionStatus'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'email',
          'createdAt',
          'activeBusinessId',
          'businessIds',
          'subscriptionPlan',
          'subscriptionStatus'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.createdAt is timestamp
        && request.resource.data.activeBusinessId == null
        && request.resource.data.businessIds is list
        && request.resource.data.businessIds.size() == 0
        && request.resource.data.subscriptionPlan == 'free'
        && request.resource.data.subscriptionStatus == 'active';
    }

    function validRecordId(documentId) {
      return request.resource.data.id == documentId;
    }

    function validCustomer(documentId) {
      return validRecordId(documentId)
        && request.resource.data.customerNumber is string
        && request.resource.data.customerNumber.matches('^[0-9]{3,}$')
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 200
        && request.resource.data.createdAt is string;
    }

    function validCustomerCounter() {
      return request.resource.data.keys().hasOnly(['nextCustomerNumber'])
        && request.resource.data.keys().hasAll(['nextCustomerNumber'])
        && request.resource.data.nextCustomerNumber is int
        && request.resource.data.nextCustomerNumber >= 1
        && request.resource.data.nextCustomerNumber <= 2147483647;
    }

    function validQuotationCounter() {
      return request.resource.data.keys().hasOnly(['nextQuotationNumber'])
        && request.resource.data.keys().hasAll(['nextQuotationNumber'])
        && request.resource.data.nextQuotationNumber is int
        && request.resource.data.nextQuotationNumber >= 1
        && request.resource.data.nextQuotationNumber <= 2147483647;
    }

    function validInvoiceCounter() {
      return request.resource.data.keys().hasOnly(['nextInvoiceNumber'])
        && request.resource.data.keys().hasAll(['nextInvoiceNumber'])
        && request.resource.data.nextInvoiceNumber is int
        && request.resource.data.nextInvoiceNumber >= 1
        && request.resource.data.nextInvoiceNumber <= 2147483647;
    }

    function validProject(documentId) {
      return validRecordId(documentId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.customerId is string
        && request.resource.data.status is string
        && request.resource.data.startDate is string
        && request.resource.data.expectedCompletionDate is string;
    }

    function validQuotation(documentId) {
      return validRecordId(documentId)
        && request.resource.data.quotationNumber is string
        && request.resource.data.customerId is string
        && request.resource.data.projectName is string
        && request.resource.data.issueDate is string
        && request.resource.data.validUntil is string
        && request.resource.data.items is list
        && request.resource.data.markupPercent is number
        && request.resource.data.discount is number
        && request.resource.data.taxPercent is number;
    }

    function validInvoice(documentId) {
      return validRecordId(documentId)
        && request.resource.data.invoiceNumber is string
        && request.resource.data.customerId is string
        && request.resource.data.projectId is string
        && request.resource.data.issueDate is string
        && request.resource.data.dueDate is string
        && request.resource.data.items is list
        && request.resource.data.subtotal is number
        && request.resource.data.tax is number
        && request.resource.data.total is number
        && request.resource.data.amountPaid is number
        && request.resource.data.balance is number;
    }

    function validMaterial(documentId) {
      return validRecordId(documentId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.category is string
        && request.resource.data.unit is string
        && request.resource.data.cost is number
        && request.resource.data.cost >= 0
        && request.resource.data.isActive is bool;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && validProfile(userId);

      allow read: if signedIn() && request.auth.uid == userId;

      allow update: if signedIn()
        && request.auth.uid == userId
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['fullName', 'email', 'activeBusinessId'])
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.fullName is string
            && request.resource.data.fullName.size() > 0
            && request.resource.data.fullName.size() <= 120
            && (
              request.resource.data.activeBusinessId == null
              || (
                request.resource.data.activeBusinessId in resource.data.businessIds
                && isActiveMember(request.resource.data.activeBusinessId)
              )
            )
          )
          || validBusinessProfileUpdate(userId)
        );

      allow delete: if false;
    }

    match /businesses/{businessId} {
      allow read: if isActiveMember(businessId);

      allow create: if signedIn()
        && validNewBusiness(businessId);

      allow update: if canManageBusiness(businessId)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'logoBase64',
              'defaultQuotationTemplate',
              'bankName',
              'bankAccountName',
              'bankAccountNumber',
              'bankBranch',
              'bankBranchCode',
              'paymentInstructions',
              'updatedAt'
            ])
        && request.resource.data.logoBase64 is string
        && request.resource.data.logoBase64.size() <= 700000
        && request.resource.data.defaultQuotationTemplate in [
          'minimal',
          'standard_blue',
          'modern_green',
          'navy_gold',
          'professional_grey',
          'elegant_teal',
          'modern_orange',
          'dark_premium',
          'construction',
          'professional_red'
        ]
        && request.resource.data.bankName is string
        && request.resource.data.bankAccountName is string
        && request.resource.data.bankAccountNumber is string
        && request.resource.data.bankBranch is string
        && request.resource.data.bankBranchCode is string
        && request.resource.data.paymentInstructions is string
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /members/{userId} {
        allow read: if signedIn()
          && (request.auth.uid == userId || canManageBusiness(businessId));

        allow create: if validOwnerMembershipCreate(businessId, userId);

        allow update, delete: if false;
      }

      match /invitations/{invitationId} {
        allow read: if canManageBusiness(businessId);
        allow create, update, delete: if false;
      }

      match /customers/{customerId} {
        allow read: if isActiveMember(businessId);

        allow create, update: if hasRole(
            businessId,
            ['owner', 'admin', 'estimator', 'employee']
          )
          && validCustomer(customerId);

        allow delete: if hasRole(businessId, ['owner', 'admin']);
      }

      match /settings/{settingId} {
        allow read: if (
            settingId == 'customerCounter'
            || settingId == 'quotationCounter'
            || settingId == 'invoiceCounter'
          )
          && isActiveMember(businessId);

        allow create: if (
            (
              settingId == 'customerCounter'
              && hasRole(
                businessId,
                ['owner', 'admin', 'estimator', 'employee']
              )
              && validCustomerCounter()
            )
            ||
            (
              settingId == 'quotationCounter'
              && hasRole(
                businessId,
                ['owner', 'admin', 'estimator']
              )
              && validQuotationCounter()
            )
            ||
            (
              settingId == 'invoiceCounter'
              && hasRole(
                businessId,
                ['owner', 'admin', 'estimator']
              )
              && validInvoiceCounter()
            )
          );

        allow update: if (
            (
              settingId == 'customerCounter'
              && hasRole(
                businessId,
                ['owner', 'admin', 'estimator', 'employee']
              )
              && validCustomerCounter()
              && request.resource.data.nextCustomerNumber
                  > resource.data.nextCustomerNumber
            )
            ||
            (
              settingId == 'quotationCounter'
              && hasRole(
                businessId,
                ['owner', 'admin', 'estimator']
              )
              && validQuotationCounter()
              && request.resource.data.nextQuotationNumber
                  > resource.data.nextQuotationNumber
            )
            ||
            (
              settingId == 'invoiceCounter'
              && hasRole(
                businessId,
                ['owner', 'admin', 'estimator']
              )
              && validInvoiceCounter()
              && request.resource.data.nextInvoiceNumber
                  > resource.data.nextInvoiceNumber
            )
          );

        allow delete: if false;
      }

      match /projects/{projectId} {
        allow read: if isActiveMember(businessId);

        allow create, update: if hasRole(
            businessId,
            ['owner', 'admin', 'estimator', 'employee']
          )
          && validProject(projectId);

        allow delete: if hasRole(businessId, ['owner', 'admin']);
      }

      match /quotations/{quotationId} {
        allow read: if isActiveMember(businessId);

        allow create, update: if hasRole(
            businessId,
            ['owner', 'admin', 'estimator']
          )
          && validQuotation(quotationId);

        allow delete: if hasRole(businessId, ['owner', 'admin']);
      }

      match /invoices/{invoiceId} {
        allow read: if isActiveMember(businessId);

        allow create, update: if hasRole(
            businessId,
            ['owner', 'admin', 'estimator']
          )
          && validInvoice(invoiceId);

        allow delete: if hasRole(businessId, ['owner', 'admin']);
      }

      match /materials/{materialId} {
        allow read: if isActiveMember(businessId);

        allow create, update: if hasRole(
            businessId,
            ['owner', 'admin', 'estimator']
          )
          && validMaterial(materialId);

        allow delete: if hasRole(businessId, ['owner', 'admin']);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
